.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Generated runtime and model state.
.models/
.runtime/
.locks/

# Local research workspace. These files are retained on development machines
# but are intentionally absent from the end-user repository.
/AGENTS.md
/design-qa.md
/artifacts/
/configs/
/reports/
/native/
/runtime/docs/

# Keep only the small public documentation surface in Git.
/docs/*
!/docs/cli.md
!/docs/install.md
!/docs/models.md
!/docs/quickstart.md
!/docs/app.md
!/docs/sdk.md

# Keep the final paper and its buildable LaTeX source; local ledgers and
# duplicate render assets remain ignored.
/paper/*
!/paper/ElasticUMA-paper.pdf
!/paper/README.md
!/paper/latex/
!/paper/latex/**
/paper/latex/build/

# Only the end-user runtime bootstrap belongs in the public scripts directory.
/scripts/*
!/scripts/bootstrap_candidate_runtime.sh
!/scripts/package_macos_app.sh

# Secrets and local overrides.
.env
.env.*
!.env.example
