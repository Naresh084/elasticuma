--- /dev/null
+++ b/Tests/TurboFieldfare/Core/Infrastructure/Streaming/PreadExpertStreamerTests+Purgeable.swift
@@ -0,0 +1,85 @@
+import Foundation
+import Metal
+import Testing
+
+@testable import TurboFieldfare
+
+extension PreadExpertStreamerTests {
+  @Test func coldSlotsBecomeVolatileWhileHotSlotStaysResident() throws {
+    let url = try Self.writeSyntheticLayer()
+    defer { try? FileManager.default.removeItem(at: url) }
+    let device = try MetalContext().device
+    let streamer = try PreadExpertStreamer(
+      layout: Self.makeLayout(path: url.path), device: device, slotCount: 4)
+
+    _ = try streamer.loadExpertsCached(experts: [0, 1, 2, 3])
+    for _ in 0..<3 {
+      _ = try streamer.loadExpertsCached(experts: [0])
+    }
+    let action = streamer.makeColdSlotsVolatile(keepingHotSlots: 1)
+    #expect(action.occupiedSlots == 4)
+    #expect(action.keptSlots == 1)
+    #expect(action.transitionedSlots == 3)
+    #expect(action.affectedBytes == UInt64(3 * Self.expertStride))
+
+    let hotPlan = streamer.planExpertsCached(experts: [0])
+    #expect(hotPlan.hits == 1)
+    let coldPlan = streamer.planExpertsCached(experts: [1])
+    #expect(coldPlan.hits == 1)
+    let cold = try streamer.executeExpertCachePlan(coldPlan)[0]
+    let got = Self.bytes(of: cold.buffer, offset: cold.offset, count: Self.expertStride)
+    #expect(got.allSatisfy { $0 == Self.tagByte(1) })
+
+    let stats = streamer.expertCacheResidencyStats()
+    #expect(stats.volatileTransitions == 3)
+    #expect(stats.revalidations == 1)
+    #expect(stats.retainedRevalidations == 1)
+    #expect(stats.emptyRecoveries == 0)
+  }
+
+  @Test func discardedColdSlotsBecomeMissesAndReloadExactBytes() throws {
+    let url = try Self.writeSyntheticLayer()
+    defer { try? FileManager.default.removeItem(at: url) }
+    let device = try MetalContext().device
+    let streamer = try PreadExpertStreamer(
+      layout: Self.makeLayout(path: url.path), device: device, slotCount: 4)
+
+    _ = try streamer.loadExpertsCached(experts: [0, 1, 2])
+    for _ in 0..<3 {
+      _ = try streamer.loadExpertsCached(experts: [0])
+    }
+    let action = streamer.discardColdSlots(keepingHotSlots: 1)
+    #expect(action.transitionedSlots == 2)
+    #expect(action.affectedBytes == UInt64(2 * Self.expertStride))
+
+    let plan = streamer.planExpertsCached(experts: [0, 1, 2])
+    #expect(plan.hits == 1)
+    #expect(plan.misses == [1, 2])
+    let results = try streamer.executeExpertCachePlan(plan)
+    for (index, result) in results.enumerated() {
+      let got = Self.bytes(
+        of: result.buffer, offset: result.offset, count: Self.expertStride)
+      #expect(got.allSatisfy { $0 == Self.tagByte([0, 1, 2][index]) })
+    }
+
+    let stats = streamer.expertCacheResidencyStats()
+    #expect(stats.explicitDiscards == 2)
+    #expect(stats.emptyRecoveries == 2)
+    #expect(stats.invalidatedSlots == 2)
+    #expect(stats.reclaimedBytes == UInt64(2 * Self.expertStride))
+  }
+
+  @Test func emptyCacheResidencyActionsAreNoOps() throws {
+    let url = try Self.writeSyntheticLayer()
+    defer { try? FileManager.default.removeItem(at: url) }
+    let device = try MetalContext().device
+    let streamer = try PreadExpertStreamer(
+      layout: Self.makeLayout(path: url.path), device: device, slotCount: 4)
+
+    #expect(streamer.makeColdSlotsVolatile(keepingHotSlots: 1)
+      == ExpertCacheResidencyAction())
+    #expect(streamer.discardColdSlots(keepingHotSlots: 1)
+      == ExpertCacheResidencyAction())
+    #expect(streamer.expertCacheResidencyStats() == ExpertCacheResidencyStats())
+  }
+}
