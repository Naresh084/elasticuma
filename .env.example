# Optional: move the one canonical cache to another disk.
# ELASTICUMA_CACHE_ROOT=/Volumes/FastSSD/elasticuma

# Keep at least this much disk free after a planned download.
ELASTICUMA_DISK_RESERVE_GIB=100

# Refuse any one model whose published file total exceeds this value.
ELASTICUMA_MAX_MODEL_GIB=80

# Bound all packed and Hugging Face model artifacts in the canonical store.
ELASTICUMA_STORE_LIMIT_GIB=120
